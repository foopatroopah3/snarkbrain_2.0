---
import Base from "./Base.astro"
import { breadcrumbs, webPage } from "../lib/schema"

interface Props {
  title: string
  description: string
  lede?: string
  schemaType?: string
}

const { title, description, lede = description, schemaType = "WebPage" } = Astro.props
const path = Astro.url.pathname
const crumbs = [
  { name: "Home", path: "/" },
  { name: title, path },
]
---

<Base
  title={title}
  description={description}
  graph={[webPage(schemaType, path, title, description), breadcrumbs(crumbs)]}
>
  <div class="container container--prose">
    <header class="page-head">
      <h1>{title}</h1>
      <p>{lede}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>
