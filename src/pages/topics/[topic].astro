---
import Base from "../../layouts/Base.astro"
import ArticleCard from "../../components/ArticleCard.astro"
import VerdictTally from "../../components/VerdictTally.astro"
import { TOPICS, type Topic } from "../../site"
import { getArticles, topicCounts, topicUrl, type Article } from "../../lib/articles"
import { breadcrumbs, webPage } from "../../lib/schema"

export async function getStaticPaths() {
  const all = await getArticles()
  return topicCounts(all).map(t => ({
    params: { topic: t.topic },
    props: { topic: t.topic, all },
  }))
}

interface Props {
  topic: Topic
  all: Article[]
}

const { topic, all } = Astro.props
const { label, description } = TOPICS[topic]
const articles = all.filter(a => a.data.tags.includes(topic))
const others = topicCounts(all)
const path = topicUrl(topic)
const title = `${label} fact-checks`
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Topics", path: "/topics/" },
  { name: label, path },
]
---

<Base
  title={title}
  description={description}
  graph={[webPage("CollectionPage", path, title, description), breadcrumbs(crumbs)]}
>
  <div class="container">
    <header class="page-head">
      <h1>{label}</h1>
      <p>{description}</p>
      <div class="tools">
        <VerdictTally articles={articles} />
      </div>
    </header>

    <nav aria-label="Topics" class="filter">
      <ul class="chips chips--scroll">
        <li>
          <a class="chip" href="/articles/">
            All <span class="count">{all.length}</span>
          </a>
        </li>
        {others.map(t => (
          <li>
            <a class="chip" href={topicUrl(t.topic)} aria-current={t.topic === topic ? "page" : undefined}>
              {t.label} <span class="count">{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="card-grid">
      {articles.map((a, i) => (
        <li>
          <ArticleCard article={a} level={2} eager={i < 3} priority={i === 0} />
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .tools {
    margin-top: 1.5rem;
  }

  .filter {
    margin-bottom: 2rem;
  }
</style>
