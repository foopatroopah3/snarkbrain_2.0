---
import Base from "../layouts/Base.astro"
import ArticleCard from "../components/ArticleCard.astro"
import VerdictTally from "../components/VerdictTally.astro"
import { getArticles, topicCounts, topicUrl } from "../lib/articles"
import { breadcrumbs, webPage } from "../lib/schema"

const articles = await getArticles()
const topics = topicCounts(articles)

const title = "All fact-checks"
const description =
  "Every claim we've checked about Ethan Klein, Hila Klein and the H3 Podcast, newest first. Each one is rated and backed by primary sources."
const crumbs = [
  { name: "Home", path: "/" },
  { name: title, path: "/articles/" },
]
---

<Base
  title={title}
  description={description}
  graph={[webPage("CollectionPage", "/articles/", title, description), breadcrumbs(crumbs)]}
>
  <div class="container">
    <header class="page-head">
      <h1>{title}</h1>
      <p>Every claim we've checked, newest first.</p>
      <div class="tools">
        <VerdictTally articles={articles} />
      </div>
    </header>

    <nav aria-label="Topics" class="filter">
      <ul class="chips chips--scroll">
        <li>
          <a class="chip" href="/articles/" aria-current="page">
            All <span class="count">{articles.length}</span>
          </a>
        </li>
        {topics.map(t => (
          <li>
            <a class="chip" href={topicUrl(t.topic)}>
              {t.label} <span class="count">{t.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="card-grid">
      {articles.map((a, i) => (
        <li>
          <ArticleCard article={a} level={2} eager={i < 3} priority={i === 0} />
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }

  .filter {
    margin-bottom: 2rem;
  }
</style>
