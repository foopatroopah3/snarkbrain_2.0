---
import Base from "../layouts/Base.astro"
import ArticleCard from "../components/ArticleCard.astro"
import SearchBox from "../components/SearchBox.astro"
import { getArticles } from "../lib/articles"

const latest = (await getArticles()).slice(0, 3)
---

<Base title="Page not found" description="The page you were looking for doesn't exist on SnarkBrain." noindex>
  <div class="container">
    <header class="page-head">
      <p class="kicker">404</p>
      <h1>Page not found</h1>
      <p>It may have moved or never existed.</p>
      <div class="search">
        <SearchBox />
      </div>
    </header>
    <ul class="card-grid card-row">
      {latest.map(a => (
        <li>
          <ArticleCard article={a} level={2} sizes="(min-width: 76rem) 360px, (min-width: 44rem) 45vw, 66vw" />
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .search {
    margin-top: 1.5rem;
  }
</style>
