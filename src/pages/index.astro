---
import { Image } from "astro:assets"
import Base from "../layouts/Base.astro"
import ArticleCard from "../components/ArticleCard.astro"
import Definition from "../components/Definition.astro"
import { SITE } from "../site"
import { citationCount, getArticles, topicCounts, topicUrl } from "../lib/articles"
import { webPage } from "../lib/schema"
import logoMark from "../assets/logo-mark.png"

const articles = await getArticles()
const latest = articles.slice(0, 3)
const topics = topicCounts(articles)
const sources = articles.reduce((n, a) => n + citationCount(a), 0)

const title = `${SITE.name}: Fact-checks on Ethan Klein, Hila Klein & H3`
const graph = [webPage("WebPage", "/", title, SITE.description)]
---

<Base title={title} graph={graph}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="copy">
        <h1
          set:html={SITE.tagline
            .replace(/(Ethan|Hila) Klein|H3 Podcast/g, m => m.replace(" ", "&nbsp;"))
            .replace("Hila&nbsp;Klein ", "Hila&nbsp;Klein<br />")}
        />
        <p class="lede">
          Viral accusations, traced back to the full clips and public records they came from, with every claim rated and
          every source cited.
        </p>
        <a class="more" href="/about/">
          Learn more →
        </a>
        <dl class="stats">
          <div>
            <dt>Topics</dt>
            <dd data-count={topics.length}>{topics.length}</dd>
          </div>
          <div>
            <dt>Claims checked</dt>
            <dd data-count={articles.length}>{articles.length}</dd>
          </div>
          <div>
            <dt>Sources cited</dt>
            <dd data-count={sources}>{sources}</dd>
          </div>
        </dl>
      </div>
      <div class="art">
        <Image
          src={logoMark}
          alt="SnarkBrain logo: a melting pink brain"
          widths={[280, 420, 560, 764]}
          sizes="(min-width: 60rem) 420px, 70vw"
          loading="eager"
          fetchpriority="high"
        />
        <Definition />
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="latest-label">
    <div class="section-head">
      <h2 id="latest-label">Latest fact-checks</h2>
      <a href="/articles/">All fact-checks →</a>
    </div>
    <ul class="card-grid card-row">
      {latest.map(a => (
        <li>
          <ArticleCard article={a} sizes="(min-width: 76rem) 360px, (min-width: 44rem) 45vw, 66vw" />
        </li>
      ))}
    </ul>
  </section>

  <section class="container section topics" aria-labelledby="topics-label">
    <div class="section-head">
      <h2 id="topics-label">Browse by topic</h2>
      <a href="/topics/">All topics →</a>
    </div>
    <ul class="chips">
      {topics.map(t => (
        <li>
          <a class="chip" href={topicUrl(t.topic)}>
            {t.label} <span class="count">{t.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section" aria-labelledby="method-label">
    <div class="method">
      <div>
        <p class="kicker">How we work</p>
        <h2 id="method-label">Primary sources, full context, every claim cited</h2>
      </div>
      <ol class="steps" role="list">
        <li>
          <span class="n" aria-hidden="true">
            1
          </span>
          <strong>Find the original</strong>
          <p>
            We go back to the full episode, the unedited clip, the court filing or the public record, not the
            screenshot.
          </p>
        </li>
        <li>
          <span class="n" aria-hidden="true">
            2
          </span>
          <strong>Restore the context</strong>
          <p>We show what was said before and after, and what was happening at the time.</p>
        </li>
        <li>
          <span class="n" aria-hidden="true">
            3
          </span>
          <strong>Cite everything</strong>
          <p>Every factual statement links to its source, down to the timestamp.</p>
        </li>
      </ol>
      <a class="button button--ghost" href="/methodology/">
        Read our methodology
      </a>
    </div>
  </section>
</Base>

<script>
  const counters = document.querySelectorAll<HTMLElement>("[data-count]")
  if (counters.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          io.unobserve(entry.target)
          const el = entry.target as HTMLElement
          const end = Number(el.dataset.count)
          const start = performance.now()
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / 900)
            el.textContent = String(Math.round(end * (1 - (1 - p) ** 3)))
            if (p < 1) requestAnimationFrame(tick)
          }
          requestAnimationFrame(tick)
        }
      },
      { threshold: 0.6 },
    )
    counters.forEach(el => io.observe(el))
  }
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background: radial-gradient(60rem 30rem at 85% -10%, var(--brand-tint), transparent 70%), var(--paper);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem);
  }

  .copy {
    display: grid;
    gap: 1.25rem;
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--ink-2);
    max-width: 36rem;
  }

  .more {
    justify-self: start;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 28rem;
    margin: 1rem 0 0;
    text-align: center;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
  }

  .stats dt {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .stats dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-sans);
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .art {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  .art img {
    width: min(100%, 420px);
  }

  .method {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem) clamp(1rem, 0.5rem + 2.5vw, 2.75rem);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
    border: 1px solid var(--line);
    text-align: center;
  }

  .method h2 {
    margin-top: 0.5rem;
    max-width: 32rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.3rem + 2.5vw, 2.5rem);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.5rem;
  }

  .n {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand-text);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .steps strong {
    text-wrap: balance;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
  }

  .steps p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .topics {
    padding-top: 0;
  }

  @media (max-width: 40rem) {
    .art :global(.entry) {
      gap: 0.35rem;
      font-size: clamp(0.75rem, 3.6vw, 1rem);
    }
    .art :global(dfn) {
      font-size: clamp(0.85rem, 4vw, 1.35rem);
    }
    .art :global(.pron) {
      font-size: clamp(0.65rem, 3vw, 0.9rem);
    }
    .steps strong {
      font-size: 0.8rem;
    }
    .steps p {
      font-size: 0.8rem;
      line-height: 1.45;
    }
    .n {
      width: 1.7rem;
      height: 1.7rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .art {
      display: block;
      padding: 1rem 1.1rem;
      border: 1px dashed var(--line-strong);
      border-radius: var(--radius);
      background: var(--surface);
    }
    .art img {
      float: left;
      width: clamp(64px, 20vw, 150px);
      margin: 0.2rem 1rem 0.4rem 0;
    }
    .art :global(.definition) {
      padding: 0;
      border: 0;
      background: none;
    }
  }

  @media (min-width: 40rem) and (max-width: 60rem) {
    .art {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: 1.5rem;
    }
    .art img {
      float: none;
      margin: 0;
    }
  }
</style>
