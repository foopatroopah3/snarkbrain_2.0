---
interface Props {
  label?: string
}

const { label = "Search fact-checks…" } = Astro.props
---

<form class="search-box" action="/articles/" role="search" data-search-open>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <label>
    <span class="visually-hidden">Search fact-checks</span>
    <input type="search" name="q" placeholder={label} readonly />
  </label>
  <kbd>/</kbd>
</form>

<style>
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 34rem;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    cursor: text;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .search-box:hover {
    border-color: var(--brand);
    box-shadow:
      var(--shadow-sm),
      0 0 0 4px var(--brand-tint);
  }

  svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 2;
    stroke-linecap: round;
  }

  label {
    flex: 1;
    display: flex;
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--ink);
    cursor: text;
    outline: none;
  }

  kbd {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    color: var(--ink-3);
  }

  @media (hover: none), (pointer: coarse) {
    kbd {
      display: none;
    }
  }
</style>
