---
import { Image } from "astro:assets"
import VerdictBadge from "./VerdictBadge.astro"
import { TOPICS } from "../site"
import { articleUrl, formatDate, isoDate, type Article } from "../lib/articles"

interface Props {
  article: Article
  level?: 2 | 3
  eager?: boolean
  priority?: boolean
  sizes?: string
}

const {
  article,
  level = 3,
  eager = false,
  priority = false,
  sizes = "(min-width: 76rem) 360px, (min-width: 44rem) 45vw, 92vw",
} = Astro.props
const { title, description, date, verdict, tags, featuredImage } = article.data
const Heading = `h${level}` as "h2" | "h3"
---

<article class="card">
  <div class="media">
    <Image
      src={featuredImage}
      alt=""
      widths={[360, 560, 760]}
      sizes={sizes}
      loading={eager || priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      data-fade
      onload="this.classList.add('is-loaded')"
    />
    <VerdictBadge verdict={verdict} size="sm" />
  </div>
  <div class="body">
    <Heading class="title">
      <a href={articleUrl(article)}>{title}</a>
    </Heading>
    <p class="desc">{description}</p>
    <p class="meta">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{TOPICS[tags[0]].label}</span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }

  .media {
    position: relative;
    background: var(--surface-2);
  }

  .media {
    overflow: hidden;
  }

  .media img {
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .media :global(.verdict) {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    box-shadow:
      0 2px 8px rgb(0 0 0 / 0.18),
      inset 0 0 0 1px color-mix(in srgb, var(--v-fg) 22%, transparent);
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem 1.1rem 1.1rem;
  }

  .title {
    font-size: 1.075rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .title a {
    text-decoration: none;
    color: var(--ink);
  }

  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card:hover .media img {
    transform: scale(1.04);
  }

  .card:hover .title a {
    color: var(--brand-text);
  }

  .desc {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    margin-top: auto;
    padding-top: 0.25rem;
    display: flex;
    gap: 0.4rem;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-3);
  }

  .meta span:last-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover,
    .card:hover .media img {
      transition: none;
      transform: none;
    }
  }
</style>
