<dialog id="search" class="search" aria-label="Search fact-checks" closedby="any">
  <div class="panel">
    <form class="bar" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <label for="search-input" class="visually-hidden">
        Search fact-checks
      </label>
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="Search fact-checks…"
        autocomplete="off"
        spellcheck="false"
        aria-controls="search-results"
      />
      <button type="button" class="close" data-search-close aria-label="Close search">
        <span class="key">Esc</span>
        <svg class="x" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </form>
    <div id="search-results" class="results" aria-live="polite"></div>
  </div>
</dialog>

<script>
  const open = (query?: string) => import("../scripts/search").then(m => m.open(query))

  document.addEventListener("click", e => {
    const trigger = (e.target as Element).closest<HTMLElement>("[data-search-open]")
    if (!trigger) return
    e.preventDefault()
    open(trigger.dataset.searchQuery)
  })

  document.addEventListener("keydown", e => {
    const t = e.target as HTMLElement
    const typing = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)
    if ((e.key === "/" && !typing) || (e.key === "k" && (e.metaKey || e.ctrlKey))) {
      e.preventDefault()
      open()
    }
  })

  const q = new URLSearchParams(location.search).get("q")
  if (q) open(q)
</script>

<style>
  .search {
    width: min(40rem, calc(100% - 2rem));
    max-height: min(36rem, calc(100dvh - 4rem));
    margin: 8vh auto auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition:
      opacity 180ms ease,
      transform 180ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .search::backdrop {
    background: rgb(20 19 23 / 0.45);
    backdrop-filter: blur(3px);
    transition: opacity 180ms ease;
  }

  @starting-style {
    .search[open] {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }

    .search[open]::backdrop {
      opacity: 0;
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .bar svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 2;
    stroke-linecap: round;
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--ink);
    outline: none;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .close {
    flex: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: none;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink-3);
    cursor: pointer;
  }

  .close .x {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    .close {
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--surface-2);
    }
    .close .key {
      display: none;
    }
    .close .x {
      display: block;
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: var(--ink-2);
      stroke-width: 2.2;
      stroke-linecap: round;
    }
  }

  .results {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .results :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
  }

  .results :global(a) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 0.75rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
  }

  .results :global(a:hover),
  .results :global(a:focus-visible) {
    background: var(--brand-tint);
    outline: none;
  }

  .results :global(.title) {
    font-family: var(--font-sans);
    font-weight: 650;
    line-height: 1.35;
  }

  .results :global(.excerpt) {
    grid-column: 1 / -1;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .results :global(.empty) {
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }
</style>
