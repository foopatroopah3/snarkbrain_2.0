---
import type { ImageMetadata } from "astro"
import { Font, getImage } from "astro:assets"
import { SITE } from "../site"
import { isoDate } from "../lib/articles"
import { organization, toJsonLd, website } from "../lib/schema"
import ogDefault from "../assets/og-default.png"
import logoMark from "../assets/logo-mark.png"

export interface Props {
  title: string
  description?: string
  image?: ImageMetadata | string
  imageAlt?: string
  type?: "website" | "article"
  published?: Date
  modified?: Date
  tags?: string[]
  graph?: object[]
  noindex?: boolean
}

const {
  title,
  description = SITE.description,
  image = ogDefault,
  imageAlt = `${SITE.name} logo`,
  type = "website",
  published,
  modified,
  tags = [],
  graph = [],
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, SITE.url).href
const pageTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`
const ogSrc =
  typeof image === "string"
    ? image
    : (await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpeg", quality: 80 })).src
const ogUrl = new URL(ogSrc, SITE.url).href
const logo = await getImage({ src: logoMark, width: 512, format: "png" })
const jsonLd = toJsonLd([organization(new URL(logo.src, SITE.url).href), website(), ...graph])
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<script is:inline>
  document.documentElement.classList.add("js")
  try {
    const t = localStorage.getItem("theme")
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t
  } catch {}
</script>
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf8f4" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141317" />

<Font cssVariable="--font-serif" preload={[{ style: "normal" }]} />
<Font cssVariable="--font-sans" preload />

<link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
<link rel="icon" href="/favicon-32.png?v=2" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} fact-checks`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{published && <meta property="article:published_time" content={isoDate(published)} />}
{modified && <meta property="article:modified_time" content={isoDate(modified)} />}
{tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={jsonLd} />
