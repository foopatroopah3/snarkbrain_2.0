---

<section class="share" aria-labelledby="share-label" data-pagefind-ignore>
  <h2 id="share-label">Share this fact-check</h2>
  <div class="buttons">
    {targets.map(t => (
      <a
        class="btn"
        href={t.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Share on ${t.name}`}
        title={t.name}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={t.icon} />
        </svg>
      </a>
    ))}
    <button type="button" class="btn copy" data-share-copy={url} aria-label="Copy link" title="Copy link">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="line">
        <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" />
      </svg>
      <span class="copied" aria-live="polite"></span>
    </button>
    <button
      type="button"
      class="btn native"
      data-share-native
      data-url={url}
      data-title={title}
      data-text={text}
      aria-label="More sharing options"
      title="Share"
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="line">
        <path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" />
      </svg>
    </button>
  </div>
</section>

<script>
  const native = document.querySelector<HTMLButtonElement>("[data-share-native]")
  if (native && "share" in navigator) {
    native.hidden = false
    native.addEventListener("click", () => {
      const { url, title, text } = native.dataset
      navigator.share({ url, title, text }).catch(() => {})
    })
  }

  const copy = document.querySelector<HTMLButtonElement>("[data-share-copy]")
  copy?.addEventListener("click", async () => {
    const status = copy.querySelector(".copied")!
    let ok = true
    try {
      await navigator.clipboard.writeText(copy.dataset.shareCopy!)
    } catch {
      ok = false
    }
    status.textContent = ok ? "Link copied" : "Couldn't copy"
    copy.classList.add("shown", ok ? "done" : "failed")
    setTimeout(() => {
      copy.classList.remove("shown", "done", "failed")
      status.textContent = ""
    }, 2000)
  })
</script>

<style>
  .share {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: 1rem;
    font-weight: 700;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }

  .btn:hover {
    color: var(--ink);
    border-color: var(--brand);
    background: var(--brand-tint);
  }

  .btn[hidden] {
    display: none;
  }

  svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  svg.line {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .copied {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    translate: -50% 0;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .copy.shown .copied {
    opacity: 1;
  }

  .copy.done {
    border-color: var(--v-true-fg);
    color: var(--v-true-fg);
  }

  .copy.failed {
    border-color: var(--v-false-fg);
    color: var(--v-false-fg);
  }

  @media (max-width: 34rem) {
    .buttons {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 2.75rem);
      justify-content: space-between;
      width: 100%;
      gap: 0.35rem;
    }

    .btn {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      align-self: start;
    }
  }
</style>
